{
  "name": "accredian-assessment-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/copy-mediapipe-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/db-guard.ts \"run development migrations\" && prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:reset": "tsx scripts/db-guard.ts \"reset the database\" && prisma migrate reset",
    "db:studio": "prisma studio",
    "staff:create-admin": "tsx --conditions=react-server scripts/create-admin.ts",
    "outbox:work": "tsx --conditions=react-server scripts/outbox-worker.ts",
    "dev:exam-password": "tsx --conditions=react-server scripts/dev-exam-password.ts",
    "dev:learner-password": "tsx --conditions=react-server scripts/dev-exam-password.ts",
    "postinstall": "prisma generate && node scripts/copy-mediapipe-assets.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/storage-js": "2.117.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
