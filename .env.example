# Copy to .env and fill in values:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string used by the app, Prisma CLI and seed.
DATABASE_URL="postgresql://assessment:CHANGE_ME@localhost:5432/assessment_dev?schema=public"

# Separate database for integration tests (npm run test:integration).
# It is migrated automatically and wiped between tests — never point it at real data.
TEST_DATABASE_URL="postgresql://assessment:CHANGE_ME@localhost:5432/assessment_test?schema=public"

# Used only by docker-compose.yml to create the local Postgres container.
# Must match the user/password in the URLs above.
POSTGRES_USER="assessment"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="assessment_dev"
POSTGRES_PORT="5432"

# --- Public address -------------------------------------------------------------
# Used for links in emails and one-time password links, and for the upload same-origin check.
# Required in production (https://, not localhost). Defaults to http://localhost:3000 otherwise.
# APP_URL="https://assessments.example.org"

# --- Sessions -------------------------------------------------------------------
# Staff sessions end after this long without activity, and at most this long after sign-in.
STAFF_SESSION_IDLE_MINUTES="30"
STAFF_SESSION_MAX_HOURS="12"
# Learner exam sessions allow a longer pause (reading a question makes no requests) and are also
# bounded by the exam password's validity.
LEARNER_SESSION_IDLE_MINUTES="120"
LEARNER_SESSION_MAX_HOURS="12"
# After results are published, the exam password still signs the learner in to view their result
# for this many days; then it expires.
RESULTS_ACCESS_DAYS="30"
# "true" only when a reverse proxy in front of the app sets X-Forwarded-For itself (the client IP
# for sign-in throttling and audit is read from it). Required in production.
TRUST_PROXY="false"

# --- Files ----------------------------------------------------------------------
# Where uploaded files (supporting materials, learner answers) are stored.
# "local" keeps them in a folder on this machine (development); "supabase" uses a private Supabase
# Storage bucket (production); "memory" is for tests only.
# Required in production ("supabase", or "local" with an absolute STORAGE_LOCAL_DIR).
STORAGE_DRIVER="local"
# Folder for the local driver (default outside production: ~/.accredian-assessment/storage).
# Keep it outside synced folders such as OneDrive.
# STORAGE_LOCAL_DIR=""

# Supabase Storage (STORAGE_DRIVER="supabase"). Server-side only: the service-role key bypasses
# Storage policies, so never prefix these with NEXT_PUBLIC_ and never use them in browser code.
# The bucket must be private; files are only ever served through the app's own access checks.
# STORAGE_DRIVER="supabase"
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_STORAGE_BUCKET="assessment-files"
# Malware scanning of uploads. "none": no scanning engine is connected; files are recorded as
# NOT scanned (never as clean). "test" is for automated tests only. Required in production.
MALWARE_SCANNER="none"

# --- Email ----------------------------------------------------------------------
# "outbox" records every email in Communication History without sending it (no email service is
# connected yet). Required in production; "test" is for automated tests only.
# Emails are queued and delivered after the request; run `npm run outbox:work` to retry failures.
EMAIL_PROVIDER="outbox"

# --- Seed (development only) ----------------------------------------------------
# Password given to every demo account created by `npm run db:seed` (min 8 chars).
# The seed refuses to run with NODE_ENV=production or against a database whose name doesn't
# contain "dev", "local" or "test". Production staff accounts: `npm run staff:create-admin`.
SEED_USER_PASSWORD="CHANGE_ME_TOO"
